{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "det pairwise 모델·행(pairwise.json)",
  "description": "det generation 산출물(사이트에 게시하지 않음). 엔드포인트별 후보 모델(p<i>/v<j> 라벨 역매핑), 고정·제외 후보, 배제 조합, PICT 행과 케이스 대응. pict 경로·홈 경로는 담지 않는다.",
  "type": "object",
  "required": ["schema", "order", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "order": {"type": "integer", "minimum": 2},
    "endpoints": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/endpoint"}
    }
  },
  "$defs": {
    "label": {"type": "string", "pattern": "^v[0-9]+$"},
    "param": {"type": "string", "pattern": "^p[0-9]+$"},
    "candidateBody": {
      "type": "object",
      "required": ["kind", "provenance", "source", "transform"],
      "properties": {
        "kind": {"enum": ["literal", "omit", "null", "uniq", "spread"]},
        "value": {},
        "range": {
          "type": "object",
          "required": ["lo", "hi", "excluded"],
          "additionalProperties": false,
          "properties": {
            "lo": {"type": "integer"},
            "hi": {"type": "integer"},
            "excluded": {"type": "array", "items": {"type": "integer"}}
          }
        },
        "provenance": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "transform": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "allOf": [{"$ref": "#/$defs/candidateBody"}],
      "required": ["label"],
      "properties": {"label": {"$ref": "#/$defs/label"}},
      "unevaluatedProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["params", "fixed", "dropped", "exclusions", "effectiveOrder", "skipped", "reason", "rows"],
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["param", "loc", "field", "candidates"],
            "additionalProperties": false,
            "properties": {
              "param": {"$ref": "#/$defs/param"},
              "loc": {"enum": ["body", "query"]},
              "field": {"type": "string"},
              "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
            }
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": {
            "allOf": [{"$ref": "#/$defs/candidateBody"}],
            "required": ["label", "reason"],
            "properties": {
              "label": {"$ref": "#/$defs/label"},
              "reason": {"enum": ["state-field", "count-field", "rel-dependent", "stored-or-unresolved-only", "single-candidate"]}
            },
            "unevaluatedProperties": false
          }
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["loc", "field", "candidate", "address", "reason"],
            "additionalProperties": false,
            "properties": {
              "loc": {"enum": ["body", "query"]},
              "field": {"type": "string"},
              "candidate": {"allOf": [{"$ref": "#/$defs/candidateBody"}], "unevaluatedProperties": false},
              "address": {"type": "string"},
              "reason": {"enum": ["single-atom", "partial-constraint", "reduced-single-atom"]}
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 2,
            "propertyNames": {"$ref": "#/$defs/param"},
            "additionalProperties": {"$ref": "#/$defs/label"}
          }
        },
        "effectiveOrder": {"type": "integer", "minimum": 0},
        "skipped": {"enum": [null, "fields<2"]},
        "reason": {"enum": [null, "pairwise-too-large", "pairwise-infeasible"]},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labels", "caseId", "mergedInto"],
            "additionalProperties": false,
            "properties": {
              "labels": {
                "type": "object",
                "propertyNames": {"$ref": "#/$defs/param"},
                "additionalProperties": {"$ref": "#/$defs/label"}
              },
              "caseId": {"type": ["string", "null"]},
              "mergedInto": {"type": ["string", "null"]},
              "assumes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
