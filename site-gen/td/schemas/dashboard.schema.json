{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dashboard.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projects"],
  "properties": {
    "schema": {"const": 1},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "repo": {"type": "string", "minLength": 1},
          "sut": {"type": "string", "minLength": 1},
          "sonarKey": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "labels", "none", "rules"],
      "properties": {
        "order": {"type": "array", "items": {"enum": ["crit", "warn", "none", "good"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crit", "warn", "none", "good"],
          "properties": {
            "crit": {"type": "string"}, "warn": {"type": "string"},
            "none": {"type": "string"}, "good": {"type": "string"}
          }
        },
        "none": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allMissing"],
          "properties": {"allMissing": {"type": "array", "items": {"type": "string"}}}
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "when", "reason"],
            "properties": {
              "level": {"enum": ["crit", "warn"]},
              "when": {"$ref": "#/$defs/condition"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "columns"],
      "properties": {
        "summary": {"type": "array", "items": {"type": "string"}},
        "columns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabs", "trend"],
      "properties": {
        "tabs": {"type": "array", "items": {"type": "string"}},
        "trend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "snapshot"],
          "properties": {
            "run": {"type": "array", "items": {"type": "string"}},
            "snapshot": {"type": "array", "items": {"type": "string"}}
          }
        },
        "headline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "when": {"$ref": "#/$defs/condition"},
              "text": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "if": {"required": ["all"]},
      "then": {
        "additionalProperties": false,
        "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}
      },
      "else": {
        "additionalProperties": false,
        "required": ["metric", "op", "value"],
        "properties": {
          "metric": {"type": "string"},
          "op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]},
          "value": {"type": ["number", "string", "boolean"]}
        }
      }
    }
  }
}
