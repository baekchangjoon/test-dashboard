td:Vet_firstName a owl:DatatypeProperty ;
    rdfs:label "firstName",
        "veterinarian first name"@en ;
    td:annotation "Column",
        "NotBlank" ;
    td:fromJqa "field:org.springframework.samples.petclinic.vet.Vet#firstName" ;
