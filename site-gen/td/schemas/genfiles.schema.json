{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S06 LLM 출력 계약: generation 파일 목록",
  "description": "path는 features/<이름>.feature, glue/<이름>Steps.java, glue/support/<이름>.java만 허용한다(한 단계, 숨김 이름과 상위 경로 금지).",
  "type": "object",
  "required": ["files"],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(features/[^/\\\\.\\u0000-\\u001f][^/\\\\\\u0000-\\u001f]*\\.feature|glue/[A-Za-z_][A-Za-z0-9_]*Steps\\.java|glue/support/[A-Za-z_][A-Za-z0-9_]*\\.java)$"
          },
          "content": {"type": "string", "minLength": 1, "maxLength": 400000}
        }
      }
    }
  }
}
