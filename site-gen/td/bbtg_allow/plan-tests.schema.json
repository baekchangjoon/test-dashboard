{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bbtg plan-tests 정제 산출물(허용 목록)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "results"
  ],
  "x-forbidden-paths": [
    "test_cases[].condition",
    "test_cases[].expected",
    "test_cases[].description"
  ],
  "properties": {
    "skill": {
      "const": "plan-tests"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "data"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string"
              },
              "cross_check_warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "method": {
                "type": "string"
              },
              "summary": {
                "type": "object",
                "properties": {
                  "errorPath": {
                    "type": "integer"
                  },
                  "happyPath": {
                    "type": "integer"
                  },
                  "invalidInput": {
                    "type": "integer"
                  },
                  "total": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "test_cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "branch_value": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "param": {
                      "type": "string"
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "expected_exception": {
                      "type": "string"
                    },
                    "expected_code": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
