{% extends "base_v2.html.j2" %}
{# 스타일 주소: v2 주소(`…/static/v2/app.css`)를 받으면 그대로, v1 주소(`static/site.css`)를 받으면 같은 static 아래 v2/를 쓴다
   (index.py가 넘기는 주소를 바꾸기 전에도 이 페이지는 v2 자산만 불러온다). #}
{% set static_href = (css_href.rpartition("/")[0] ~ "/" if css_href.endswith("/app.css") else css_href.rpartition("/")[0] ~ "/v2/") if "/" in css_href else "" %}
{% set css_href = static_href ~ "app.css" %}
{% block title %}테스트 실행 기록{% endblock %}
{% block crumbs %}<a href="{{ home_href }}"><strong>test-dashboard</strong></a><span class="crumb"><b>테스트 실행 기록</b></span>{% endblock %}
{% block content %}
<h1>테스트 실행 기록</h1>
{% if not prefixes %}<p class="muted">테스트 접두가 없다.</p>{% endif %}
<ul>
{% for prefix in prefixes %}  <li><a href="{{ prefix }}/index.html">{{ prefix }}</a></li>
{% endfor %}
</ul>
{% endblock %}
