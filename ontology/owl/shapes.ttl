# S05 OWL 온톨로지 형식 검증(pySHACL, REQ-018). SUT와 무관한 일반 규칙만 둔다.
# - 모든 owl:Class: jQA 노드 id를 가리키는 provenance(td:fromJqa)와 rdfs:label이 있어야 한다.
# - 모든 owl:ObjectProperty: rdfs:domain, rdfs:range(클래스), td:fromJqa가 있어야 한다.
# - 모든 owl:DatatypeProperty: rdfs:domain, rdfs:range, td:fromJqa가 있어야 한다.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix td: <http://test-dashboard.local/ontology#> .
@prefix tdsh: <http://test-dashboard.local/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tdsh:ClassShape a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path td:fromJqa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "owl:Class에 jQA provenance(td:fromJqa)가 없다" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "owl:Class에 rdfs:label이 없다" ;
    ] .

tdsh:ObjectPropertyShape a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path td:fromJqa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "owl:ObjectProperty에 jQA provenance(td:fromJqa)가 없다" ;
    ] ;
    sh:property [
        sh:path rdfs:domain ;
        sh:minCount 1 ;
        sh:class owl:Class ;
        sh:message "owl:ObjectProperty에 rdfs:domain(클래스)이 없다" ;
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:minCount 1 ;
        sh:class owl:Class ;
        sh:message "owl:ObjectProperty에 rdfs:range(클래스)가 없다" ;
    ] .

tdsh:DatatypePropertyShape a sh:NodeShape ;
    sh:targetClass owl:DatatypeProperty ;
    sh:property [
        sh:path td:fromJqa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "owl:DatatypeProperty에 jQA provenance(td:fromJqa)가 없다" ;
    ] ;
    sh:property [
        sh:path rdfs:domain ;
        sh:minCount 1 ;
        sh:class owl:Class ;
        sh:message "owl:DatatypeProperty에 rdfs:domain(클래스)이 없다" ;
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:minCount 1 ;
        sh:message "owl:DatatypeProperty에 rdfs:range가 없다" ;
    ] .
