{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "det 조합 시각화(det-viz.json)",
  "type": "object",
  "required": [
    "version",
    "genId",
    "factors",
    "caseResults",
    "aggregates",
    "trace"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "genId": {
      "type": "string",
      "minLength": 1
    },
    "factors": {
      "$ref": "#/$defs/factors"
    },
    "caseResults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "endpoint",
          "status",
          "observed",
          "expectStrict"
        ],
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "notRun"
            ]
          },
          "observed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "expectStrict": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "aggregates": {
      "type": "object",
      "required": [
        "summary",
        "byEndpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "endpoints",
            "fields",
            "classes",
            "classesCovered",
            "pairsCovered",
            "pairsTotal",
            "outOfModel"
          ],
          "additionalProperties": false,
          "properties": {
            "endpoints": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "integer",
              "minimum": 0
            },
            "classes": {
              "type": "integer",
              "minimum": 0
            },
            "classesCovered": {
              "type": "integer",
              "minimum": 0
            },
            "pairsCovered": {
              "type": "integer",
              "minimum": 0
            },
            "pairsTotal": {
              "type": "integer",
              "minimum": 0
            },
            "outOfModel": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "byEndpoint": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "classes",
              "pairs"
            ],
            "additionalProperties": false,
            "properties": {
              "classes": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "state",
                    "cases",
                    "boundaryCases",
                    "unresolved"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "enum": [
                        "covered-pass",
                        "covered-fail",
                        "covered-notrun",
                        "unresolved",
                        "empty"
                      ]
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "boundaryCases": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unresolved": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "index",
                          "reason"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "pairs": {
                "type": "object",
                "required": [
                  "total",
                  "covered",
                  "matrix"
                ],
                "additionalProperties": false,
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "covered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "matrix": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "a",
                        "b",
                        "counts"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "a": {
                          "type": "string"
                        },
                        "b": {
                          "type": "string"
                        },
                        "counts": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "caseSources",
        "unresolvedEndpoints"
      ],
      "additionalProperties": false,
      "properties": {
        "caseSources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "unresolvedEndpoints": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
