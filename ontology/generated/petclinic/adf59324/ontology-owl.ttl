td:Pet a owl:Class ;
    rdfs:label "Pet",
        "Pet"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.owner.Pet" ;
    td:javaType "org.springframework.samples.petclinic.owner.Pet" ;
    td:kind "Entity" ;
    rdfs:comment "An animal owned by an owner, classified by a pet type and having a history of visits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Pet_name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Pet_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:Visit ;
            owl:onProperty td:Pet_visits ] ;
    owl:disjointWith td:PetType,
        td:Reservation,
        td:Specialty,
        td:Vet,
        td:Visit .

td:Visit a owl:Class ;
    rdfs:label "Visit",
        "Visit"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.owner.Visit" ;
    td:javaType "org.springframework.samples.petclinic.owner.Visit" ;
    td:kind "Entity" ;
    rdfs:comment "A dated visit of a pet to the clinic with a description."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Visit_description ] ;
    owl:disjointWith td:PetType,
        td:Reservation,
        td:Specialty,
        td:Vet .

td:Vet a owl:Class ;
    rdfs:label "Vet",
        "Veterinarian"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.vet.Vet" ;
    td:javaType "org.springframework.samples.petclinic.vet.Vet" ;
    td:kind "Entity" ;
    rdfs:comment "A veterinarian working at the clinic who may have specialties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Vet_firstName ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Vet_lastName ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:Specialty ;
            owl:onProperty td:Vet_specialties ] ;
    owl:disjointWith td:PetType,
        td:Reservation,
        td:Specialty .

td:Specialty a owl:Class ;
    rdfs:label "Specialty",
        "Specialty"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.vet.Specialty" ;
    td:javaType "org.springframework.samples.petclinic.vet.Specialty" ;
    td:kind "Entity" ;
    rdfs:comment "A named area of veterinary expertise that a veterinarian can have."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Specialty_name ] .

td:PetType a owl:Class ;
    rdfs:label "PetType",
        "Pet type"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.owner.PetType" ;
    td:javaType "org.springframework.samples.petclinic.owner.PetType" ;
    td:kind "Entity" ;
    rdfs:comment "A named category of animal used to classify pets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:PetType_name ] ;
    owl:disjointWith td:Specialty .

td:Owner a owl:Class ;
    rdfs:label "Owner",
        "Owner"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.owner.Owner" ;
    td:javaType "org.springframework.samples.petclinic.owner.Owner" ;
    td:kind "Entity" ;
    rdfs:comment "A person registered with the clinic who owns one or more pets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Owner_firstName ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Owner_lastName ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Owner_address ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Owner_city ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty td:Owner_telephone ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:Pet ;
            owl:onProperty td:Owner_pets ] ;
    owl:disjointWith td:Pet,
        td:PetType,
        td:Reservation,
        td:Specialty,
        td:Vet,
        td:Visit .

td:Reservation a owl:Class ;
    rdfs:label "Reservation",
        "Boarding reservation"@en ;
    td:fromJqa "entity:org.springframework.samples.petclinic.boarding.Reservation" ;
    td:javaType "org.springframework.samples.petclinic.boarding.Reservation" ;
    td:kind "Entity" ;
    rdfs:comment "A boarding reservation for a pet, with room, nights, check-in date, pricing and status."@en ;
    owl:disjointWith td:PetType,
        td:Specialty .

