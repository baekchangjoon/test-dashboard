{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "det generation 팩터·클래스·칸(factors.json)",
  "type": "object",
  "required": ["version", "endpoints", "sources", "cases", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint", "methods", "fields"],
        "additionalProperties": false,
        "properties": {
          "endpoint": {"type": "string", "minLength": 1},
          "methods": {"type": "array", "items": {"type": "string", "pattern": "^[^#]+#[^#]+$"}},
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "classes"],
              "additionalProperties": false,
              "properties": {
                "field": {"type": "string", "pattern": "^(path|query|body)\\..+$"},
                "classes": {
                  "type": "array",
                  "minItems": 1,
                  "prefixItems": [{"allOf": [{"$ref": "#/$defs/class"}, {"required": ["kind"], "properties": {"kind": {"const": "valid"}}}]}],
                  "items": {"$ref": "#/$defs/class"}
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "methods", "condition", "expected"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["plan", "keyparams", "graph", "harness", "input"]},
          "methods": {"type": "array", "items": {"type": "string"}},
          "condition": {"type": ["string", "null"]},
          "expected": {"type": ["string", "null"]}
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rule", "cells", "boundaries", "stored", "storedBoundaries", "enumValue", "inModel", "outReason", "mergedRules", "cellConflicts"],
        "additionalProperties": false,
        "properties": {
          "rule": {"type": "string"},
          "cells": {"$ref": "#/$defs/cells"},
          "boundaries": {"type": "array", "items": {"$ref": "#/$defs/classId"}},
          "stored": {"type": "array", "items": {"type": "string"}},
          "storedBoundaries": {"type": "array", "items": {"type": "string"}},
          "enumValue": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "required": ["field", "constant"], "additionalProperties": false,
               "properties": {"field": {"type": "string"}, "constant": {"type": "string"}}}
            ]
          },
          "inModel": {"type": "boolean"},
          "outReason": {"enum": [null, "auth", "no-data", "empty-body", "filter-empty"]},
          "mergedRules": {"type": "array", "items": {"type": "string"}},
          "cellConflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "kept", "merged", "mergedRule"],
              "additionalProperties": false,
              "properties": {
                "field": {"type": "string"},
                "kept": {"$ref": "#/$defs/classId"},
                "merged": {"$ref": "#/$defs/classId"},
                "mergedRule": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "source", "rule", "reason", "draftKey", "cells"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "source": {"type": "string", "minLength": 1},
          "rule": {"type": "string"},
          "reason": {"type": "string"},
          "draftKey": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3}
            ]
          },
          "cells": {"$ref": "#/$defs/cells"}
        }
      }
    }
  },
  "$defs": {
    "classId": {"type": "string", "pattern": "^c[0-9a-f]{12}$"},
    "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/classId"}},
    "class": {
      "type": "object",
      "required": ["id", "kind", "label", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/classId"},
        "kind": {"enum": ["valid", "violation", "branch", "count", "raw", "contradicted"]},
        "label": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
