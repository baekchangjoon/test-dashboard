# hotspot-analysis 설정 템플릿(유효한 YAML). td.hotspot.render_config가 "${NAME}" 값을 채우고 yaml.safe_dump로 쓴다.
# 상대 경로는 실행 디렉터리(cwd) 기준으로 해석되므로 경로 값은 모두 절대 경로로 채운다.
# "${CLASSPATH_DIRS}" 항목은 디렉터리 목록으로 펼쳐지고, "${JACOCO_XML}" 값은 S08 병합 XML이 없으면 키째 빠진다.
analysis:
  target:
    type: local-git
    path: "${TARGET_PATH}"
  window:
    since: "${SINCE}"
    until: "${UNTIL}"
  scope:
    granularity: [file, method]
    include:
      - "${SOURCES}/**/*.java"
    exclude:
      - "**/generated/**"
      - "**/test/**"
      - "**/build/**"
  scoring:
    decayHalfLifeDays: 90
  apiAnalysis:
    enabled: true
    sharedComponentMode: BOTH
    classpathDirectories:
      - "${CLASSPATH_DIRS}"
  jacocoReportPath: "${JACOCO_XML}"
output:
  formats: [csv, yaml, md, html]
  apiLayout: BOTH
  path: "${OUTPUT_PATH}"
  topN: 50
