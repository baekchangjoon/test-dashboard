{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "호스팅 비교 데이터(<prefix>hosting.json)",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "runId", "sut", "hosts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "sut": {"type": "string", "minLength": 1},
    "hosts": {
      "type": "object",
      "required": ["reports", "dash"],
      "additionalProperties": false,
      "properties": {
        "reports": {"$ref": "#/$defs/host"},
        "dash": {"$ref": "#/$defs/host"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "number": {"type": "number", "minimum": 0},
    "host": {
      "type": "object",
      "required": ["label", "quantitative", "qualitative"],
      "additionalProperties": false,
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "quantitative": {
          "type": "object",
          "required": ["deploy", "ttfb", "homeTransfer", "memory"],
          "additionalProperties": false,
          "properties": {
            "deploy": {
              "type": "object",
              "required": ["seconds", "unit", "basis"],
              "additionalProperties": false,
              "properties": {
                "seconds": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
                "unit": {"const": "s"},
                "basis": {"$ref": "#/$defs/text"}
              }
            },
            "ttfb": {
              "type": "object",
              "required": ["medianMs", "unit", "samples", "ok", "failed", "timeoutSeconds", "url", "warm"],
              "additionalProperties": false,
              "properties": {
                "medianMs": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
                "unit": {"const": "ms"},
                "samples": {"type": "integer", "minimum": 1},
                "ok": {"type": "integer", "minimum": 0},
                "failed": {"type": "integer", "minimum": 0},
                "timeoutSeconds": {"$ref": "#/$defs/number"},
                "url": {"$ref": "#/$defs/text"},
                "warm": {"type": "boolean"}
              }
            },
            "homeTransfer": {
              "type": "object",
              "required": ["ms", "unit", "bytes", "url"],
              "additionalProperties": false,
              "properties": {
                "ms": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
                "unit": {"const": "ms"},
                "bytes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
                "url": {"$ref": "#/$defs/text"}
              }
            },
            "memory": {
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["beforeMb", "afterMb", "unit", "metric"],
                  "additionalProperties": false,
                  "properties": {
                    "beforeMb": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
                    "afterMb": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
                    "unit": {"const": "MB"},
                    "metric": {"const": "available"}
                  }
                }
              ]
            }
          }
        },
        "qualitative": {
          "type": "object",
          "required": ["cost", "operations", "failureScope"],
          "additionalProperties": false,
          "properties": {
            "cost": {
              "type": "object",
              "required": ["monthlyUsdIncremental", "monthlyUsdStandalone", "priceBasis", "region", "asOf", "source", "assumptions", "formula"],
              "additionalProperties": false,
              "properties": {
                "monthlyUsdIncremental": {"$ref": "#/$defs/number"},
                "monthlyUsdStandalone": {"$ref": "#/$defs/number"},
                "priceBasis": {"$ref": "#/$defs/text"},
                "region": {"$ref": "#/$defs/text"},
                "asOf": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "source": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "required": ["name", "url"], "additionalProperties": false,
                    "properties": {"name": {"$ref": "#/$defs/text"}, "url": {"type": "string", "pattern": "^https://"}}
                  }
                },
                "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
                "formula": {"$ref": "#/$defs/text"}
              }
            },
            "operations": {"$ref": "#/$defs/text"},
            "failureScope": {"$ref": "#/$defs/text"}
          }
        }
      }
    }
  }
}
