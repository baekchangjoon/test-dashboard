#!/usr/bin/env bash
# claude 호출 기록 shim. 호출 메타데이터(시각, 허용 목록에 있는 플래그 이름, cwd)를
# $TD_LLM_CALL_LOG에 한 줄 JSON으로 남기고 실제 claude를 exec한다.
# 프롬프트 본문과 플래그 값은 기록하지 않는다(허용 목록 밖의 인자는 "<other>").
set -u

realpath_of() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
self="$(realpath_of "${BASH_SOURCE[0]}")"

if [[ -n "${TD_LLM_CALL_LOG:-}" ]]; then
  python3 - "$TD_LLM_CALL_LOG" "$PWD" "$@" <<'PY'
import datetime, json, sys

log_path, cwd, args = sys.argv[1], sys.argv[2], sys.argv[3:]
BOOLEAN_FLAGS = {"-p", "--print", "--strict-mcp-config", "--verbose"}
VALUE_FLAGS = {"--tools", "--mcp-config", "--setting-sources", "--system-prompt",
               "--output-format", "--model", "--allowedTools", "--disallowedTools"}
logged, skip_next = [], False
for arg in args:
    if skip_next:
        skip_next = False
        continue
    name, has_inline_value, _ = arg.partition("=")
    if arg in BOOLEAN_FLAGS:
        logged.append(arg)
    elif arg in VALUE_FLAGS:
        logged.append(arg)
        skip_next = True
    elif has_inline_value and name in VALUE_FLAGS:
        logged.append(name)
    else:
        logged.append("<other>")
record = {"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
          "argv": logged, "cwd": cwd}
with open(log_path, "a") as fh:
    fh.write(json.dumps(record, ensure_ascii=False) + "\n")
PY
fi

real="${TD_REAL_CLAUDE:-}"
if [[ -z "$real" ]]; then
  IFS=: read -r -a dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    cand="$d/claude"
    if [[ -x "$cand" && "$(realpath_of "$cand")" != "$self" ]]; then real="$cand"; break; fi
  done
fi
if [[ -z "$real" ]]; then
  echo "claude-shim: 실제 claude 바이너리를 찾을 수 없다(TD_REAL_CLAUDE 설정 필요)" >&2
  exit 127
fi
exec "$real" "$@"
