{% extends "base_v2.html.j2" %}
{% block title %}arm 비교 판정{% endblock %}
{% block crumbs %}<strong>test-dashboard</strong><span class="crumb">run 리포트 › <b>arm 비교 판정</b></span>{% endblock %}
{% block content %}
<h1>arm 비교 판정</h1>
<p class="muted">SUT {{ doc.sut }} · 커밋 {{ doc.commit }} · run {{ doc.runId }} · arm당 반복 횟수 <b id="reps">{{ doc.reps if doc.reps is not none else "—" }}</b>회</p>
<p class="note" id="exploratory"><b>{{ doc.label }}</b>: 표본이 작아 아래 수치와 판정은 가설을 점검하는 참고 자료이며 통계적 결론이 아니다.</p>
{% if doc.clock.clockShift %}
<p class="note" id="clock-shift" role="alert"><b>시계 경계 경고</b>: 이 run은 시작({{ doc.clock.startedAt }})과 종료({{ doc.clock.finishedAt or "미기록" }})가 {{ doc.clock.tz }} 기준 서로 다른 날짜에 걸쳤다. 날짜에 의존하는 규칙(체크인 미래 여부, 48시간 취소 제한)의 결과가 실행 중 바뀌었을 수 있다.</p>
{% endif %}

{% if doc.warnings %}
<div class="note" id="compare-warnings" role="alert"><b>데이터 경고</b>
<ul>{% for w in doc.warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
{% endif %}

<h2>판정</h2>
<section class="cards" id="verdict">
  <div class="card" id="verdict-generation" data-verdict="{{ doc.verdict.generation }}">
    <h3>생성 가설</h3>
    <div class="kpi"><div><b>{{ doc.verdict.generation }}</b><span class="muted">탐색적 관찰</span></div></div>
    <p class="muted">기준: 온톨로지 arm 평균이 컴파일 ≥ 90%, undefined ≤ 10%, 통과율 ≥ 70%, 엔드포인트 ≥ 80%.{% if doc.verdict.detail.generation.passingArms %} 충족한 arm: {{ doc.verdict.detail.generation.passingArms | join(", ") }}.{% endif %}</p>
  </div>
  <div class="card" id="verdict-effect" data-verdict="{{ doc.verdict.effect }}">
    <h3>온톨로지 효과</h3>
    <div class="kpi"><div><b>{{ doc.verdict.effect }}</b><span class="muted">탐색적 관찰</span></div></div>
    <p class="muted">기준: 온톨로지 arm의 [최소, 최대]가 base와 겹치지 않으면서 엔드포인트, 브랜치, 오라클 중 하나 이상이 더 높다. 겹치면 차이 불명확이다.{% if doc.verdict.detail.effect.effectiveArms %} 효과가 보인 arm: {{ doc.verdict.detail.effect.effectiveArms | join(", ") }}.{% endif %}</p>
  </div>
</section>

<h2>arm × 지표</h2>
<p class="muted">각 칸은 평균(최소–최대). 엔드포인트 분모는 {{ doc.endpoints.denominator }}개(view=false), 오라클 규칙은 {{ doc.oracle.rules }}개{% if doc.focus %}, Focus 범위는 <code>{{ doc.focus }}</code>{% endif %}이다.{% if doc.blackbox %} blackbox 기준 라인 {{ ("%.1f%%"|format(doc.blackbox.line * 100)) if doc.blackbox.line is not none else "—" }}, 브랜치 {{ ("%.1f%%"|format(doc.blackbox.branch * 100)) if doc.blackbox.branch is not none else "—" }}.{% else %} blackbox 스위트가 이번 run에 없어 blackbox 대비 값은 비어 있다.{% endif %}</p>
<div class="scroll"><table id="compare-table">
<thead><tr><th>지표</th>{% for arm, entry in doc.arms.items() %}{% set denom = entry.requestedReps if entry.requestedReps is defined and entry.requestedReps is not none else entry.reps %}<th class="num" data-arm="{{ arm }}">{{ arm }}{% if entry.status != "ok" %} (skipped){% else %} (n={{ entry.measured }}/{{ denom if denom is not none else "?" }}){% endif %}{% if arm in reference_arms %}<br><span class="muted" data-regime="{{ arm }}">참고 열 · {{ regime_labels[arm] }}</span>{% endif %}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in rows %}
  <tr data-metric="{{ row.key }}"><td>{{ row.label }}</td>
  {% for arm, cell in row.cells.items() %}
    {% if cell %}<td class="num"><b>{{ cell.mean }}</b> <span class="muted">({{ cell.min }}–{{ cell.max }})</span></td>{% else %}<td class="num muted">—</td>{% endif %}
  {% endfor %}
  </tr>
{% endfor %}
</tbody></table></div>
{% for arm, entry in doc.arms.items() %}
  {% if entry.status != "ok" %}<p class="note" data-skipped-arm="{{ arm }}"><b>{{ arm }}</b> arm을 비교에서 뺐다(skipped): {{ entry.reason }}</p>{% endif %}
  {% for failed in entry.failedGenerations or [] %}<p class="note" data-failed-generation="{{ failed.genId }}"><b>{{ failed.genId }}</b>는 측정하지 못해 평균에서 뺐다: {{ failed.reason }}</p>{% endfor %}
{% endfor %}

{% if "det" in doc.arms %}
<p class="note" id="reference-arms"><b>det</b>는 참고 열이다. 입력 체제가 다르다({{ regime_labels["det"] }}, 그래프 jQA+보강 질의). 위 판정에는 base·jqa·owl만 쓰고 det는 넣지 않았다. det의 반복 횟수는 요청과 무관하게 1회다.</p>
{% endif %}
{% if doc.deterministic %}
<h2>det 결정적 생성 결과</h2>
<section class="card" id="deterministic" data-gen="{{ doc.deterministic.genId }}">
{% if doc.deterministic.status != "measured" %}
  <p class="note"><b>{{ doc.deterministic.genId }}</b> 결과를 집계하지 못했다: {{ doc.deterministic.reason }}</p>
{% else %}{% set d = doc.deterministic.summary %}
  <p class="muted">generation {{ doc.deterministic.genId }} · 케이스 {{ d.cases }}개, 생성 불가 {{ d.unresolved }}건{% if d.universe.theoretical %}, 이론 모수(상한) {{ d.universe.theoretical.value }}{% endif %}</p>
  <div class="scroll"><table id="det-summary">
  <tbody>
    <tr data-det="passStrict"><td>strict 통과</td><td class="num">{{ d.passStrict.passed }}/{{ d.passStrict.total }}</td></tr>
    <tr data-det="passClass"><td>상태 계열(class) 통과</td><td class="num">{{ d.passClass.passed }}/{{ d.passClass.total }}</td></tr>
    <tr data-det="verifiedViolations"><td>검증된 위반(위반·짝·baseline 모두 통과)</td><td class="num">{{ d.verifiedViolations }}</td></tr>
    <tr data-det="blockedByBaseline"><td>baseline 실패로 막힌 위반</td><td class="num">{{ d.blockedByBaseline }}</td></tr>
    <tr data-det="unpaired"><td>짝 없는 위반(검증 불가)</td><td class="num">{{ d.unpaired }}</td></tr>
    <tr data-det="classUnknown"><td>관측 코드 없음(실패) / 실행 안 됨</td><td class="num">{{ d.classUnknown }} / {{ d.notRun }}</td></tr>
    <tr data-det="statusMismatch"><td>bbtg·그래프 기대 상태 불일치</td><td class="num">{{ d.statusMismatch | length }}</td></tr>
  </tbody></table></div>
  <div class="scroll"><table id="det-by-rule">
  <thead><tr><th>규칙</th><th class="num">생성</th><th class="num">strict 통과</th></tr></thead>
  <tbody>{% for rule, slot in d.byRule.items() %}<tr><td>{{ rule }}</td><td class="num">{{ slot.generated }}</td><td class="num">{{ slot.passedStrict }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% if d.baselineValid %}<p class="muted">baseline-valid: {% for ep, st in d.baselineValid.items() %}<code>{{ ep }}</code> {{ st }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
{% endif %}
</section>
{% endif %}

<h2>generation별 값</h2>
<p class="muted">점 하나가 generation 하나다. 가로 막대는 [최소, 최대] 범위다.</p>
<section class="cards" id="dot-plots">
{% for plot in dots %}
  <div class="card" data-plot="{{ plot.key }}">
    <h3>{{ plot.label }}</h3>
    <svg viewBox="0 0 {{ plot.width }} {{ plot.height }}" width="100%" role="img" aria-label="{{ plot.label }} generation별 점 그래프">
      {% for tick in plot.ticks %}
      <line x1="{{ tick.x }}" x2="{{ tick.x }}" y1="8" y2="{{ plot.axis_y }}" stroke="currentColor" stroke-opacity="0.15"/>
      <text x="{{ tick.x }}" y="{{ plot.height - 2 }}" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.7">{{ tick.text }}</text>
      {% endfor %}
      {% for row in plot.rows %}
      <text x="{{ plot.left - 6 }}" y="{{ row.y + 4 }}" font-size="12" text-anchor="end" fill="currentColor">{{ row.arm }}</text>
      {% if row.skipped %}<text x="{{ plot.left + 6 }}" y="{{ row.y + 4 }}" font-size="11" fill="currentColor" fill-opacity="0.6">skipped</text>{% endif %}
      {% if row.range %}<line x1="{{ row.range[0] }}" x2="{{ row.range[1] }}" y1="{{ row.y }}" y2="{{ row.y }}" style="stroke:{{ row.color }}" stroke-width="3" stroke-opacity="0.35"/>{% endif %}
      {% for point in row.points %}<circle cx="{{ point }}" cy="{{ row.y }}" r="5" style="fill:{{ row.color }}" stroke="currentColor" stroke-opacity="0.5" data-arm="{{ row.arm }}"><title>{{ row.arm }} {{ row.values[loop.index0] }}</title></circle>{% endfor %}
      {% endfor %}
    </svg>
  </div>
{% endfor %}
</section>

<h2>오라클 규칙 커버</h2>
{% set oracle_ids = doc.oracle.ids %}
<div class="scroll"><table id="oracle-table">
<thead><tr><th>규칙</th>{% for arm, entry in doc.arms.items() %}{% if entry.status == "ok" %}{% for gen in entry.generations if gen.status == "measured" %}<th>{{ gen.genId }}</th>{% endfor %}{% endif %}{% endfor %}</tr></thead>
<tbody>
{% for rule_id in oracle_ids %}
  <tr><td>{{ rule_id }}</td>
  {% for arm, entry in doc.arms.items() %}{% if entry.status == "ok" %}{% for gen in entry.generations if gen.status == "measured" %}
    {% set hit = (gen.oracleRules | selectattr("id", "equalto", rule_id) | first).covered if gen.oracleRules else none %}
    <td>{{ "커버" if hit else ("—" if hit is none else "미커버") }}</td>
  {% endfor %}{% endif %}{% endfor %}
  </tr>
{% endfor %}
</tbody></table></div>

<h2>한계</h2>
<ul id="limitations">
{% for item in doc.limitations %}  <li>{{ item }}</li>
{% endfor %}
</ul>
<p class="muted">원본 데이터: <a href="compare.json">compare.json</a></p>
{% endblock %}
